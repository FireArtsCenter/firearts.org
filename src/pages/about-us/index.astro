---
import Layout from '@/layouts/Layout.astro';
import { type TypePageMetaData } from '@/layouts/types';
import { org } from '@/constants';
import { getYearsSinceFounding } from '@/utils/orgData';
import PageSection from '@/components/PageSection.astro';
import Note from '@/components/Note.astro';
const yearsSinceFounding = getYearsSinceFounding();

const metaData: TypePageMetaData = {
	title: 'About Us',
	description: `The ${org.name} began as a non-for-profit school of sculpture ${yearsSinceFounding} years ago and seeks to pass on our knowledge and preserve these techniques. Hopefully those who learn from us will do the same.`,
};

const sections = [
	{
		text: `The ${org.name} began as a non-for-profit school of sculpture ${yearsSinceFounding} years ago and seeks to pass on our knowledge and preserve these techniques. Hopefully those who learn from us will do the same.`,
	},
	{
		headline: 'Facilities',
		text: [
			'We have a fully equipped foundry with equipment for forging, welding, bronze and iron casting with furnaces and kilns so you can bring your ideas to life.',
			'We also offer traditional art courses such as stone carving, figure sculpture, figure drawing, etc. <a href="/location/">Come check us out!</a>',
		],
	},
	{
		headline: 'Community Outreach',
		text: `Community art projects are important to us at <strong>${org.name}</strong>. We aim to facilitate and participate in public art projects through outreach and collaboration with other community organizations. Past projects have introduced adults and children with disabilities to the excitement of metal casting, and teaching high school students the joy of metal working.`,
	},
];
---

<Layout metaData={metaData}>
	<PageSection title={`About the ${org.name}`}>
		{
			sections.map((section) => {
				let paragraphs;
				if (Array.isArray(section.text)) {
					paragraphs = section.text.reduce((acc, cur, index) => {
						const currentParagraph = `<p class="${index !== 0 ? 'mt-6' : ''}">${cur}</p>`;
						return acc + currentParagraph;
					}, '');
				} else {
					paragraphs = `<p>${section.text}<p>`;
				}
				return (
					<Note>
						{section.headline && <h3>{section.headline}</h3>}
						<div set:html={paragraphs} />
					</Note>
				);
			})
		}
	</PageSection>
</Layout>
