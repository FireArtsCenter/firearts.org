---
import Button from '@/components/Button.astro';
import Layout from '@/layouts/Layout.astro';
import Link from '@/components/Link.astro';
import { org } from '@/constants';
import { getYearsSinceFounding } from '@/utils/orgData';
import PageSection from '@/components/PageSection.astro';
import VideoIframe from '@/components/VideoIframe.astro';

const yearsSinceFounding = getYearsSinceFounding();
const pageTitle = `${yearsSinceFounding} years of high quality training`;

export const metaData = {
	description: `The ${org.name} provides instruction in foundry, forging, welding, metalsmithing, figure sculpture, and more.`,
};
---

<Layout metaData={metaData}>
	<PageSection title={pageTitle} class='pb-12'>
		<div class='pt-1 md:flex md:items-center md:pt-8'>
			<h2 class='px-0 text-xl font-semibold md:basis-7/12 md:pr-6 md:text-2xl'>
				Get access to the instruction and facilities you need to learn and
				perfect your skills now.
			</h2>
			<div class='mt-6 md:mt-0 md:basis-5/12 md:px-6'>
				<Button
					class='w-full py-6 text-xl font-bold md:block md:py-3 md:text-lg'
					href='/register/'
				>
					Register for classes
				</Button>
			</div>
		</div>
		<VideoIframe id='video-iframe' />
	</PageSection>

	<PageSection
		title='Our Mission'
		class='border-t border-border-default py-12'
		level='h2'
	>
		<div class='flex flex-col gap-6 md:flex-row'>
			<div
				class='flex basis-1/2 flex-col rounded bg-neutral-700 p-8 ring-1 ring-fac-orange'
			>
				<h3 class='pb-4'>Preserve traditional sculpture techniques</h3>
				<p>
					We offer high-quality training, technical advice, and professional
					facilities to help you master your craft and perfect your creative
					skills.
				</p>
			</div>

			<div
				class='flex basis-1/2 flex-col rounded bg-neutral-700 p-8 ring-1 ring-fac-orange'
			>
				<h3 class='pb-4'>Empower artists with career opportunities</h3>
				<p>
					Many of our instructors began here as students. Others have used these
					resources to establish thriving personal practices and careers.
				</p>
			</div>
		</div>
	</PageSection>
	<PageSection
		title='Payment Plans & Bartered Discounts'
		level='h2'
		class='border-t border-border-default py-12'
	>
		<p>
			In order to fulfil our mission we want to provide our classes to as many
			people as we can.
		</p>
		<p>
			But we understand that times are tough and finding the money to pay for
			these classes can be hard. That is why we offer split payments: half
			upfront, half later.
		</p>
		<p><strong>or</strong></p>
		<p>Do you have a skill, service, material, or equipment we can use?</p>
		<p>
			<Link href='/contact-us/'>Give us a call!</Link> let us know what you have to
			trade and we will work out a discount for you.
		</p>
	</PageSection>
</Layout>
